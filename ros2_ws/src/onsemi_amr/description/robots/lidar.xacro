<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

<!-- calculate intertia -->
    <xacro:macro name="cylinder_inertia" params="m r h">
        <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0.0" ixz="0.0"
            iyy="${m*(3*r*r+h*h)/12.0}" iyz="0"
            izz="${m*(r*r)/2.0}" />
    </xacro:macro>

    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <!-- <origin xyz="0.22 -0.20 0.20" rpy="0 0 ${pi}"/> -->
        <origin xyz="0.24 0.00 0.14" rpy="0 0 ${pi}"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <origin xyz="0 0 -0.05"/>
            <geometry>
                <cylinder radius="0.05" length="0.2"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.2"/>
            </geometry>
        </collision>       

        <inertial>
            <mass value="0.06" />
            <xacro:cylinder_inertia m="0.06" r="0.05" h="0.2" />
            <!--<inertia ixx="(1/12.0) * 0.06 * (3*0.05*0.05 + 0.04*0.04)" ixy="0.0" ixz="0.0"
                    iyy="(1/12.0) * 0.06 * (3*0.05*0.05 + 0.04*0.04)" iyz="0.0"
                    izz="(1/2.0) * 0.06 * (0.05*0.05)" />
                    <origin xyz="0 0 0" rpy="0 0 0"/-->
        </inertial>            
    </link>

    <gazebo reference="laser_frame">
        <material>Gazebo/Black</material>
        <sensor name="gpu_lidar" type="gpu_lidar">
            <pose> 0 0 0 0 0 0 </pose>

            <topic>scan</topic>
            <update_rate>10</update_rate>           
            
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.45</min>
                    <max>16</max>
                </range>
            </lidar>

            <always_on>1</always_on>
            <visualize>1</visualize>
            
            <gz_frame_id>laser_frame</gz_frame_id>
        </sensor>
    </gazebo>

</robot>
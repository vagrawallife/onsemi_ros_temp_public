<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="rplidar">

<!-- constants -->
<xacro:property name="PI" value="3.141592653" />

<!-- calculate intertia -->
<xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
        iyy="${m*r*r/2}" iyz="0"
        izz="${m*(3*r*r+h*h)/12}" />
</xacro:macro>

<material name="black">
   <color rgba="0 0 0 1"/>
</material>

<material name="grey">
   <color rgba="0.25 0.25 0.25 1"/>
</material>

<!--  define wheel -->
<xacro:macro name="lidar" params="parent origin_xyz origin_rpy">

   <link name="lidar_scan">
      <collision>
         <origin xyz="0 0 0" rpy="0 0 0"/>
         <geometry>
            <box size="0.1 0.1 0.1"/>
         </geometry>
      </collision>

      <visual>
         <origin xyz="0.10 0 0" rpy="0 ${PI} 0"/>
         <geometry>
            <mesh filename="package://amr_description/meshes/sensors/rplidar.dae" />
         </geometry>
         <material name="black"/>    
      </visual>

      <inertial>
         <mass value="1e-5" />
         <origin xyz="0 0 0" rpy="0 0 0" />
         <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
      </inertial>
   </link>

   <joint name="rplidar_joint" type="fixed">
      <parent link="base" />
      <child link = "lidar_scan" />
      <origin xyz="-0.18 -0.21 0.15" rpy="0.0 0.0 -${PI/2}" />
   </joint>

   <link name="laser"/>

   <joint name="scan_joint" type="fixed">
      <parent link="lidar_scan" />
      <child link = "laser" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${PI}" />
   </joint>

</xacro:macro>

</robot>